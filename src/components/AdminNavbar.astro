---
import { Plus, Tag } from "lucide-vue-next"
import NavLink from "./navigation/NavLink.astro"
---

<nav class="bleed-section bg-white border border-black my-4">
	<ul class="nav-links flex gap-4">
		<li><NavLink href="/">home</NavLink></li>
		<li><NavLink href="/admin/">dashboard</NavLink></li>
		<li class="relative">
			<NavLink class="peer" href="/admin/menu">menu</NavLink>

			<ul
				class="absolute top-full hidden peer-hover:flex left-0 hover:flex flex-col border border-black bg-white"
			>
				<li>
					<NavLink
						class="flex gap-4 p-4 hover:bg-gray-200"
						href="/admin/menu/categories"
					>
						<Tag />
						<span>Categories</span>
					</NavLink>
				</li>
				<li>
					<NavLink
						class="flex gap-4 p-4 hover:bg-gray-200"
						href="/admin/menu/add"
					>
						<Plus />
						<span class="flex-1">Add</span>
					</NavLink>
				</li>
			</ul>
		</li>
		<li><NavLink href="/admin/orders">orders</NavLink></li>
		<li><NavLink href="/admin/customers">customers</NavLink></li>
	</ul>
</nav>
